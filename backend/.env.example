# Salin ke backend/.env lalu isi sesuai lingkungan Anda.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="bem_fh_unisal"
# Daftar origin frontend yang diizinkan, dipisah koma, tanpa wildcard.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Isi true bila situs disajikan lewat HTTPS (termasuk di belakang reverse proxy).
COOKIE_SECURE=false
APP_URL=http://localhost:3000
APP_TZ=Asia/Jakarta

# Akun superadmin awal. WAJIB diisi (minimal 12 karakter) saat database masih kosong.
ADMIN_EMAIL=admin@bemfh.unisal.ac.id
ADMIN_INITIAL_PASSWORD=

# ---- Integrasi opsional (kosongkan bila tidak dipakai) ----
# Email transaksional (notifikasi status pendaftaran dan laporan pengaduan).
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME="BEM FH UNISAL"
# Google Sheets (sinkron pendaftar) dan Google Calendar (sinkron agenda).
SHEETS_CONNECTION_ID=
CALENDAR_CONNECTION_ID=
EMERGENT_LLM_KEY=
# Rahasia bersama untuk cron rekap pengaduan bulanan (POST /api/cron/complaint-recap).
WEBHOOK_CRON_SECRET=
